+    /// History preloaded with token sequences (each an independent response), oldest first, so a later
+    /// sequence wins a shared context. The window grows to hold the corpus plus live responses.
+    pub(crate) fn seeded(sequences: &[Vec<u32>]) -> Self {
+        let tokens: usize = sequences.iter().map(Vec::len).sum();
+        let mut history = Self::with_capacity(CAPACITY.max((2 * tokens).next_power_of_two()));
+        for tokens in sequences {
+            let mut sequence = DecodedSequence::default();
+            for &token in tokens { history.append(&mut sequence, token); }
+        }
+        history
+    }
+
     fn with_capacity(capacity: usize) -> Self {
         assert!(capacity.is_power_of_two());
         Self {
