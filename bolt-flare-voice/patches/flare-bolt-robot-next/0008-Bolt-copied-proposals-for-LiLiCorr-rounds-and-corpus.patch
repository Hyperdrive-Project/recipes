diff --git a/helios/src/scheduler.rs b/helios/src/scheduler.rs
index e5701cf4..cb727f51 100644
--- a/helios/src/scheduler.rs
+++ b/helios/src/scheduler.rs
@@ -954,6 +954,28 @@ impl RequestScheduler {
         Ok(())
     }
 
+    /// Fork: preload decoded history from a corpus file of little-endian u32 token ids, with
+    /// u32::MAX ending each response. Returns the number of seeded tokens.
+    pub fn seed_history(&mut self, path: &std::path::Path) -> Result<usize> {
+        if self.submitted != Fence(0) || self.admissions != 0 {
+            return Err("decoded history must be seeded before admission".into());
+        }
+        let bytes = std::fs::read(path).map_err(|e| format!("history seed {}: {e}", path.display()))?;
+        if bytes.len() % 4 != 0 {
+            return Err("history seed must hold whole u32 token ids".into());
+        }
+        let mut sequences = vec![Vec::new()];
+        for word in bytes.chunks_exact(4) {
+            match u32::from_le_bytes(word.try_into().unwrap()) {
+                u32::MAX => sequences.push(Vec::new()),
+                token => sequences.last_mut().unwrap().push(token),
+            }
+        }
+        let tokens = sequences.iter().map(Vec::len).sum();
+        self.decoded_history = Some(decoded_history::DecodedHistory::seeded(&sequences));
+        Ok(tokens)
+    }
+
     pub fn history_proposal(&self, context: &[u32], maximum: usize) -> ([i64; 7], usize) {
         self.decoded_history.as_ref().map_or(([-1; 7], 0), |history| history.lookup(context, maximum))
     }
