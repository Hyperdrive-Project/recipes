From 7c0dc78a6bd919cf5894fcd1d3a32346175f7a69 Mon Sep 17 00:00:00 2001
From: Hyperdrive Project <noreply@hyperdrive-project.invalid>
Date: Sun, 25 Oct 2026 14:15:49 +0000
Subject: [PATCH 2/9] scheduler: make the short prompt tail a runtime option
 (--prefill-short-tail N, --prefill-short-tail-keep-last)

Default 0 keeps upstream behaviour (all 253 scheduler tests pass). keep-last stops a short
tail at its last message boundary so reasoning re-renders can still restore there.

---
 flare/src/cli.rs               | 14 ++++++++++++++
 flare/src/main.rs              |  6 ++++++
 helios/src/scheduler/policy.rs | 32 +++++++++++++++++++++-----------
 helios/src/server/config.rs    |  8 ++++++++
 4 files changed, 49 insertions(+), 11 deletions(-)

diff --git a/flare/src/cli.rs b/flare/src/cli.rs
index 6e06426c..4226515e 100644
--- a/flare/src/cli.rs
+++ b/flare/src/cli.rs
@@ -869,6 +869,14 @@ pub struct ServingOptions {
         help_heading = "Advanced speculation options")]
     pub mtp_adaptive_verification_alpha: Option<f64>,
 
+    /// Fork: prefill prompt tails of at most N tokens without stopping at message boundaries; 0 disables [default: 0].
+    #[arg(long, value_name = "N", help_heading = "Advanced speculation options")]
+    pub prefill_short_tail: Option<u64>,
+
+    /// Fork: with --prefill-short-tail, still stop at the tail's last message boundary.
+    #[arg(long, help_heading = "Advanced speculation options")]
+    pub prefill_short_tail_keep_last: bool,
+
     /// Host memory for prefix checkpoints and prepared inputs, e.g. 16G; 0 disables [default: prefix_cache.memory, else disabled].
     #[arg(long, value_name = "SIZE", value_parser = parse_size, help_heading = "Prefix cache options")]
     pub prefix_cache_memory: Option<u64>,
@@ -990,6 +998,12 @@ impl ServingOptions {
                 alpha.to_string(),
             ]);
         }
+        if let Some(tokens) = self.prefill_short_tail {
+            options.extend(["--prefill-short-tail".into(), tokens.to_string()]);
+        }
+        if self.prefill_short_tail_keep_last {
+            options.push("--prefill-short-tail-keep-last".into());
+        }
         if let Some(storage) = self.embedding_table_storage {
             options.extend([
                 "--embedding-table-storage".into(),
