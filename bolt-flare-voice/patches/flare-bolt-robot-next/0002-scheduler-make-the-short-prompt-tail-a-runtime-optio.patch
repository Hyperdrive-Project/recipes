+        // the tail's last message boundary, so a following turn whose template re-renders this
+        // turn's reply (reasoning) can still restore there.
         let tail = request.prompt_tokens.min(limit).saturating_sub(start);
-        let mut end = if tail <= SHORT_TAIL_TOKENS && tail <= capacity {
