# Hyperdrive on Spark: runtime switches for the patched image (each is a no-op on stock TRT-LLM 1.4.0rc1).
NHD_ADAPTK=1
NHD_ADAPTK_THETA=0.25
NHD_DFLASH_PREFIX_CTX=1
NHD_F5=1
NHD_SSD_FUSED_SCAN=1
NHD_SSD_FUSED_STATE=1
NHD_PREFILL_GRAPH_TEXT_ONLY=2
NHD_VISION_ATTN_BACKEND=TRTLLM
