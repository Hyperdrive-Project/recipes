# Part of Hyperdrive recipes, https://github.com/Hyperdrive-Project/recipes
# Apache-2.0. If this helps you, a credit to Hyperdrive recipes is appreciated.
# RECIPE (docs/RECIPES.md): docker build --build-arg NHD_STACK=v3 -t nemotron-hyperdrive:1.4.0rc1-v3 .
#   IMAGE=nemotron-hyperdrive:1.4.0rc1-v3 scripts/serve.sh configs/b300/hyperdrive-b300-v2.yaml configs/b300/hyperdrive-b300-v2.env
# Paths below are the image's.
# Hyperdrive on B300, v2 (2026-11-02): the B300 env (hyperdrive-b300.env) plus the overnight kernels. Needs, on top of
# patches/hyperdrive/03 04 06 07: patches/v3/cake-ssd.diff, conv-triton.diff, mamba-norm-fp8.diff (and
# guided-skip.diff for NHD_GUIDED_SKIP), and the FlashInfer main e74a167 CAKE SSD sources (the v3 image has all of these:
# Dockerfile NHD_STACK=v3, sources in /opt/nhd/fimain-e74a167). Config: hyperdrive-b300-v2.yaml.
# Vision path (patch 05; not used by the text-only runs this was measured with).
NHD_VISION_ATTN_BACKEND=TRTLLM
# F5 needs patch 03 and NHD_MK_DIR=<repo>/patches/hyperdrive (the directory holding nhd_mk).
NHD_PREFILL_GRAPH_TEXT_ONLY=2
NHD_SSD_FUSED_SCAN=1
NHD_SSD_FUSED_STATE=1
NHD_F5=1
# CAKE Mamba2 SSD prefill (FlashInfer main, cu_seqlens form). D=1 x skip is added by our Triton pass on calls with
# initial states (D with initial states gave wrong outputs in our call path; FlashInfer alone checks out, j26b/j26c).
NHD_SSD_CAKE=1
NHD_CAKE_FORM=cu
NHD_CAKE_D_MODE=split
NHD_CAKE_FI_DIR=/opt/nhd/fimain-e74a167
NHD_CAKE_JIT_DIR=/cache/nhd_cake_jit_main
# Triton varlen causal conv1d for the Mamba2 prefill, B300-tuned tile (B200: 1x16x256x4).
NHD_CONV_TRITON=1
NHD_CONV_TILE=1x32x128x4
# Mamba2 gated RMSNorm writes FP8 straight into the FP8 out_proj.
NHD_MAMBA_NORM_FP8=1
# Skip the no-op guided-decoding host functions and GPU drains in steps without a structured-output request.
NHD_GUIDED_SKIP=1
