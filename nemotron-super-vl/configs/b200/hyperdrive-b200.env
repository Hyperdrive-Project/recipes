# Hyperdrive on B200 / B300: the Spark env minus the LiLiCorr drafter switches (B200 uses the built-in MTP heads).
NHD_VISION_ATTN_BACKEND=TRTLLM
NHD_PREFILL_GRAPH_TEXT_ONLY=2
NHD_SSD_FUSED_SCAN=1
NHD_SSD_FUSED_STATE=1
