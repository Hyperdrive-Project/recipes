# Part of Hyperdrive recipes, https://github.com/Hyperdrive-Project/recipes
# Apache-2.0. If this helps you, a credit to Hyperdrive recipes is appreciated.
# Hyperdrive on B200, v3 (2026-11-03). RECIPE (docs/RECIPES.md):
#   docker build --build-arg NHD_STACK=v3 -t nemotron-hyperdrive:1.4.0rc1-v3 .
#   scripts/make_fp4_mamba.sh
#   IMAGE=nemotron-hyperdrive:1.4.0rc1-v3 MODEL=super-vl-nvfp4-m4 scripts/serve.sh configs/b200/hyperdrive-b200-v3.yaml configs/b200/hyperdrive-b200-v3.env
# The B200 env (hyperdrive-b200.env, no F5: the B200 runs never used it) plus the cells of the measured stack, as
# our cloud job scripts ran them (CAKE SSD, conv1d, FP8 norm, guided skip, FP4 Mamba; a microbench on that GPU picked the
# CAKE D-split variant and the conv tile). Paths are the v3 image's.
# Measured: 6,280 burst / 6,307 sustained output tok/s at 128 users, 8K in / 1K out, unique prompts.
NHD_VISION_ATTN_BACKEND=TRTLLM
NHD_PREFILL_GRAPH_TEXT_ONLY=2
NHD_SSD_FUSED_SCAN=1
NHD_SSD_FUSED_STATE=1
# CAKE Mamba-2 SSD prefill (FlashInfer main e74a167, cu_seqlens form); on calls with initial states the kernel runs
# without D and a Triton pass adds D*x (FlashInfer main's per-head-D path was wrong with initial states, j08b).
NHD_SSD_CAKE=1
NHD_CAKE_FORM=cu
NHD_CAKE_D_MODE=split
NHD_CAKE_FI_DIR=/opt/nhd/fimain-e74a167
NHD_CAKE_JIT_DIR=/cache/nhd_cake_jit_main
# Triton varlen causal conv1d for the Mamba-2 prefill, B200 tile (j17c on B200: 32K tokens 619 -> 488 us).
NHD_CONV_TRITON=1
NHD_CONV_TILE=1x16x256x4
# Mamba-2 gated RMSNorm writes FP8 straight into the FP8 out_proj (steps aside by itself once out_proj is FP4).
NHD_MAMBA_NORM_FP8=1
# Skip the no-op guided-decoding host functions and GPU drains in steps without a structured-output request.
NHD_GUIDED_SKIP=1
# FP4 Mamba-2 projections (scripts/make_fp4_mamba.sh), applied after the checkpoint's shards.
NHD_WEIGHT_OVERLAY=/models/super-vl-nvfp4-m4/nhd-m4-overlay.st
