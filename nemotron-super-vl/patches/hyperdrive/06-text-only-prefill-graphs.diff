+# NHD patch (pcg-textonly): gate read once inside the serving container.
+_NHD_PCG_TEXT_ONLY = os.environ.get("NHD_PREFILL_GRAPH_TEXT_ONLY", "0")
+
+
+def _nhd_no_mm_tokens_in_chunk(ctx_params, video_pruning_rate) -> bool:
+    """Mode 2 only: True when every context request's current chunk holds zero multimodal embedding rows."""
+    if _NHD_PCG_TEXT_ONLY != "2" or not ctx_params or video_pruning_rate > 0:
+        return False
+    return all(
+        p.multimodal_runtime is not None and p.multimodal_runtime.num_mm_tokens_in_chunk == 0
+        for p in ctx_params
+    )
+
+
+@contextlib.contextmanager
+def _nhd_breakable_graph_off():
+    """Run the vision/audio encoders with the breakable-CUDA-graph flag cleared.
+
+    Under a breakable replay the flag is set for the whole outer forward; RADIO's TRTLLM attention would then take the
+    custom-op path that resolves the LLM's layers and metadata from extra_attrs. The runner keeps image chunks eager,
+    so this is a second line of defence.
+    """
+    if _NHD_PCG_TEXT_ONLY not in ("1", "2"):
+        yield
+        return
+    from ..pyexecutor.breakable_cuda_graph.context import _breakable_cuda_graph_active
+
+    token = _breakable_cuda_graph_active.set(False)
+    try:
+        yield
+    finally:
+        _breakable_cuda_graph_active.reset(token)
+
+
+def _nhd_apply_llm_torch_compile(self, *, backend, fullgraph: bool) -> None:
+    """Compile only the LLM decoder body (piecewise prefill graphs); the vision encoder stays eager."""
+    self.llm.model = torch.compile(self.llm.model, backend=backend, fullgraph=fullgraph)
+
+
+if _NHD_PCG_TEXT_ONLY in ("1", "2"):
+    NemotronHMultimodalModel.apply_llm_torch_compile = _nhd_apply_llm_torch_compile
