+    # ---- NHD tool-json -------------------------------------------------------------------------------------------
+    def _whole_parse_params(self, body: str, param_config: dict) -> Dict[str, Any]:
+        """Parameters of one function body by the detect_and_parse rules (a parameter may end at </function>)."""
+        fend = body.find("</function>")
+        if fend != -1:
+            body = body[:fend]
+        params: Dict[str, Any] = {}
+        for pm in self.tool_call_parameter_regex.findall(body):
+            ptxt = pm[0] if pm[0] else pm[1]
+            if ">" not in ptxt:
+                continue
+            pidx = ptxt.index(">")
+            pname = ptxt[:pidx].strip()
+            pval = ptxt[pidx + 1 :].lstrip("\n").rstrip("\n")
+            params[pname] = self._convert_param_value(
+                pval, pname, param_config, self._current_function_name
+            )
+        return params
+
+    def _close_streamed_arguments(
+        self, body: str, param_config: dict, complete: bool
+    ) -> List[ToolCallItem]:
+        """Emit what turns this call's streamed arguments into one complete JSON object.
+
+        complete=True: the function body is whole (</function> or </tool_call> seen), so parameters the incremental
+        regex missed are flushed with the whole-parse rules first. complete=False (stream truncated mid-call): only
+        the complete parameters already streamed are kept.
+        """
+        tid = self.current_tool_id
+        frag = ""
+        if complete:
+            final = self._whole_parse_params(body, param_config)
+            missing = [k for k in final if k not in self._current_parameters]
+            if missing:
+                items = ", ".join(
+                    f"{json.dumps(k, ensure_ascii=False)}: {json.dumps(final[k], ensure_ascii=False)}"
+                    for k in missing
+                )
+                frag += (", " + items) if self._args_opened else ("{" + items)
+                self._args_opened = True
+                self._current_parameters = {
+                    **self._current_parameters,
+                    **{k: final[k] for k in missing},
+                }
+                self.prev_tool_call_arr[tid]["arguments"] = self._current_parameters
+        frag += "}" if self._args_opened else "{}"
+        self.streamed_args_for_tool[tid] = self.streamed_args_for_tool[tid] + frag
+        return [ToolCallItem(tool_index=tid, name=None, parameters=frag)]
+
+    def finish(self, tools: List[Tool]) -> StreamingParseResult:
+        """Close a tool call the stream ended inside (EOS after </function>, or max_tokens)."""
+        if not (self._in_tool_call and self._function_name_sent):
+            return StreamingParseResult()
+        param_config = self._get_arguments_config(self._current_function_name, tools)
+        calls = self._close_streamed_arguments(
+            self._buf, param_config, complete="</function>" in self._buf
+        )
+        self._buf = ""
+        self._reset_streaming_state()
+        self.current_tool_id += 1
+        return StreamingParseResult(normal_text="", calls=calls)
+
+    @staticmethod
+    def _strict_json_ok(value: Any) -> bool:
+        try:
+            json.dumps(value, ensure_ascii=False, allow_nan=False)
+            return True
+        except (TypeError, ValueError, OverflowError):
+            return False
 
