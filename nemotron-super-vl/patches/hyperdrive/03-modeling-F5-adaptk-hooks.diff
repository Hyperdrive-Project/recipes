+# --- Nemotron Hyperdrive MegaKernel step 1: L2 weight prefetch on a side stream (opt-in) -------------------------------
+# NHD_L2_PREFETCH=1 enables it (unset/0: this file behaves exactly as upstream). The schedule lives in the mounted
+# package nhd_mk (NHD_MK_DIR, default /nhd-mk = ~/nemotron-hyperdrive/megakernel); see megakernel/DESIGN.md.
+# Forks are captured only inside CUDA-graph capture (decode/verify graphs); eager steps are untouched.
+def _nhd_l2_prefetch(model):
+    import os
+    if "_nhd_sync_debug" not in model.__dict__:
+        # Diagnostic only (DeepInfer-style hidden-sync hunt): NHD_SYNC_DEBUG=warn|error sets
+        # torch.cuda.set_sync_debug_mode in the process that runs the model, once, at its first forward.
+        model.__dict__["_nhd_sync_debug"] = os.environ.get("NHD_SYNC_DEBUG", "")
+        if model.__dict__["_nhd_sync_debug"] in ("warn", "error"):
+            torch.cuda.set_sync_debug_mode(model.__dict__["_nhd_sync_debug"])
+            logger.info(f"[nhd] torch.cuda.set_sync_debug_mode({model.__dict__[_nhd_sync_debug]!r})")
+    if os.environ.get("NHD_L2_PREFETCH", "0") in ("", "0"):
+        return None
+    pf = model.__dict__.get("_nhd_l2_pf")
+    if pf is None:
+        import sys
+        mk_dir = os.environ.get("NHD_MK_DIR", "/nhd-mk")
+        if mk_dir not in sys.path:
+            sys.path.insert(0, mk_dir)
+        from nhd_mk.nemotron_h import from_env
+        pf = from_env(list(model.layers[:model.num_hidden_layers]), log=logger.info)
+        model.__dict__["_nhd_l2_pf"] = pf
+    return pf
+
