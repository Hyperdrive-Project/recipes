+# --- Nemotron Hyperdrive MegaKernel F1: mega-gate (opt-in: NHD_F1=1) ------------------------------------------------
+# router gate GEMV + fc1_latent GEMV + DeepSeek-V3 top-22 routing in one kernel (megakernel/csrc/nhd_mega_gate.cu);
+# the MoE backend's routing call is served from its result. Decode/verify only (M <= 32); prefill is unchanged.
+# Not bit-identical (fp32 summation order); checked by megakernel/bench/mk_f1.py. NHD_F1=0/unset: upstream.
+def _nhd_f1(moe, x2d):
+    mg = moe.__dict__.get("_nhd_f1_mg", False)
+    if mg is False:
+        import os
+        mg = None
+        if os.environ.get("NHD_F1", "0") == "1" and getattr(moe, "use_latent_moe", False):
+            import sys
+            mk_dir = os.environ.get("NHD_MK_DIR", "/nhd-mk")
+            if mk_dir not in sys.path:
+                sys.path.insert(0, mk_dir)
+            from nhd_mk.mega_gate import MegaGate
+            try:
+                mg = MegaGate(moe)
+            except Exception as ex:  # unsupported shape/dtype: keep the upstream path for this layer
+                logger.warning(f"[nhd] F1 mega-gate disabled for layer {moe.layer_idx}: {ex}")
+                mg = None
+        moe.__dict__["_nhd_f1_mg"] = mg
+    if mg is None:
+        return None
+    if not mg.eligible(x2d):
+        mg.stash = None
+        return None
+    return mg(x2d)
+
+
+# --- NHD adaptive verify length (dflash-adaptk; opt-in: NHD_ADAPTK=1) -------------------------------------------------
+# Verify rows past a request's verify length (dflash.py: worker._nhd_vlen per drafter slot) take the router logits of
+# that request's last verified row, so they pick the same experts and add no unique experts to the routed GEMMs.
+# Their drafts are force-rejected in dflash.py, and rows <= vlen are untouched. Unset: _NHD_ADAPTK_SRC stays None.
+_NHD_ADAPTK_ON = None
+_NHD_ADAPTK_SRC = None
+_NHD_ADAPTK_LOGGED = False
+
+
+def _nhd_adaptk_rows(attn_metadata, spec_metadata, num_tokens):
+    global _NHD_ADAPTK_ON, _NHD_ADAPTK_LOGGED
+    if _NHD_ADAPTK_ON is None:
+        import os
+        _NHD_ADAPTK_ON = os.environ.get("NHD_ADAPTK", "0") == "1"
+    if not _NHD_ADAPTK_ON or spec_metadata is None:
+        return None
+    w = getattr(spec_metadata, "_dflash_worker", None)
+    vlen = getattr(w, "_nhd_vlen", None) if w is not None else None
+    if vlen is None or getattr(w, "_batch_to_slot", None) is None:
+        return None
+    nc = attn_metadata.num_contexts
+    ng = attn_metadata.num_seqs - nc
+    T = int(getattr(spec_metadata, "runtime_draft_len", 0) or 0) + 1
+    if ng <= 0 or T <= 1:
+        return None
+    n_ctx_tok = num_tokens - ng * T
+    if n_ctx_tok < 0:
+        return None
+    dev = vlen.device
+    vl = vlen[w._batch_to_slot[nc:nc + ng]].long()
+    j = torch.arange(T, device=dev)
+    rj = torch.minimum(j[None, :], vl[:, None])
+    gen = (n_ctx_tok + torch.arange(ng, device=dev)[:, None] * T + rj).flatten()
+    src = torch.cat([torch.arange(n_ctx_tok, device=dev), gen]) if n_ctx_tok else gen
+    if not _NHD_ADAPTK_LOGGED:
+        _NHD_ADAPTK_LOGGED = True
+        logger.info(f"[nhd-adaptk] routing override engaged (tokens={num_tokens}, gens={ng}, T={T})")
+    return src
+
+
