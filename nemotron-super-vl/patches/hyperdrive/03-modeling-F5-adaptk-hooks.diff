+# --- Nemotron Hyperdrive MegaKernel F5: fused add+RMSNorm+FP8 for the Mamba in_proj input (opt-in: NHD_F5=1) -------
+# One kernel instead of [flashinfer fused_add_rmsnorm -> BF16 -> static_quantize_e4m3_per_tensor], bit-exact by design
+# (megakernel/nhd_mk/norm_quant.py; checked by megakernel/bench/mk_f5.py). Decode and prefill. NHD_F5=0/unset: upstream.
+def _nhd_f5(layer, hidden_states, residual):
+    nq = layer.__dict__.get("_nhd_f5_mod", False)
+    if nq is False:
+        import os
+        nq = None
+        if layer.layer_type == "M" and os.environ.get("NHD_F5", "0") == "1":
+            import sys
+            mk_dir = os.environ.get("NHD_MK_DIR", "/nhd-mk")
+            if mk_dir not in sys.path:
+                sys.path.insert(0, mk_dir)
+            from nhd_mk import norm_quant as nq
+        layer.__dict__["_nhd_f5_mod"] = nq
+    if nq is None or not nq.eligible(layer.norm, layer.mixer.in_proj, hidden_states, residual):
+        return None
+    return nq.norm_fp8(layer.norm, hidden_states, residual, layer.mixer.in_proj.input_scale)
