+# Nemotron Hyperdrive (2026-10-22): fused Mamba-2 SSD chunk_state + state_passing for TRT-LLM 1.4.0rc1.
+#
+# rc1 runs _chunk_state_fwd (per-chunk local states, written as FP32: batch x nchunks x nheads x hdim x dstate) and then
+# _state_passing_fwd (reads them back, runs the inter-chunk recurrence, writes the passed states in state_dtype).
+# At 8192-token chunks that is 268 MB written + 268 MB read of FP32 intermediates per layer. This kernel computes each
+# chunk's local state in registers and folds it into the recurrence immediately, so only the passed states (what
+# chunk_scan / chunk_state_varlen consume) and the final states are written. Every arithmetic step is the rc1 code
+# (same masked loads, same exp/scale, same FP32 accumulation order over the chunk, same recurrence), so the outputs are
+# meant to be bit-identical to _chunk_state_fwd + _state_passing_fwd; tests check that on real layer data.
+import torch
+import triton
+import triton.language as tl
+
+# test hook: a dict of meta-parameters (+ num_warps/num_stages) to bypass the autotuner; None in production
+_FORCE_CONFIG = None
+
+
+@triton.autotune(
+    configs=[
+        # the 5 fastest of 10 screened on GB10 (SSD 4.10-4.21 ms vs rc1 6.68 ms per 8192-token chunk); all bit-identical
+        triton.Config({"BLOCK_SIZE_M": 32, "BLOCK_SIZE_N": 64, "BLOCK_SIZE_K": 32}, num_stages=3, num_warps=4),
+        triton.Config({"BLOCK_SIZE_M": 64, "BLOCK_SIZE_N": 32, "BLOCK_SIZE_K": 32}, num_stages=3, num_warps=4),
+        triton.Config({"BLOCK_SIZE_M": 32, "BLOCK_SIZE_N": 32, "BLOCK_SIZE_K": 32}, num_stages=3, num_warps=4),
+        triton.Config({"BLOCK_SIZE_M": 64, "BLOCK_SIZE_N": 64, "BLOCK_SIZE_K": 32}, num_stages=3, num_warps=4),
+        triton.Config({"BLOCK_SIZE_M": 64, "BLOCK_SIZE_N": 64, "BLOCK_SIZE_K": 32}, num_stages=2, num_warps=8),
+    ],
+    key=["hdim", "dstate", "chunk_size", "HAS_INITSTATES", "HAS_SEQ_IDX"],
+)
+@triton.jit
+def _fused_chunk_state_passing_kernel(
+    x_ptr, b_ptr, out_ptr, final_states_ptr, dt_ptr, dA_cumsum_ptr, initstates_ptr, seq_idx_ptr, chunk_offsets_ptr,
+    chunk_meta_num,
+    hdim, dstate, chunk_size, nchunks, seqlen, nheads_ngroups_ratio,
+    stride_x_batch, stride_x_seqlen, stride_x_head, stride_x_hdim,
+    stride_b_batch, stride_b_seqlen, stride_b_head, stride_b_dstate,
+    stride_out_batch, stride_out_chunk, stride_out_head, stride_out_hdim, stride_out_dstate,
+    stride_fs_batch, stride_fs_head, stride_fs_hdim, stride_fs_dstate,
+    stride_dt_batch, stride_dt_chunk, stride_dt_head, stride_dt_csize,
+    stride_dA_cs_batch, stride_dA_cs_chunk, stride_dA_cs_head, stride_dA_cs_csize,
+    stride_is_batch, stride_is_head, stride_is_hdim, stride_is_dstate,
+    stride_seq_idx_batch, stride_seq_idx_seqlen,
+    HAS_INITSTATES: tl.constexpr, HAS_SEQ_IDX: tl.constexpr, IS_CONT_BATCHED: tl.constexpr,
+    BLOCK_SIZE_M: tl.constexpr, BLOCK_SIZE_N: tl.constexpr, BLOCK_SIZE_K: tl.constexpr,
+):
+    pid_b = tl.program_id(axis=1).to(tl.int64)
+    pid_h = tl.program_id(axis=2)
+    num_pid_n = tl.cdiv(dstate, BLOCK_SIZE_N)
+    pid_m = tl.program_id(axis=0) // num_pid_n
+    pid_n = tl.program_id(axis=0) % num_pid_n
+    offs_m = pid_m * BLOCK_SIZE_M + tl.arange(0, BLOCK_SIZE_M)  # hdim
+    offs_n = pid_n * BLOCK_SIZE_N + tl.arange(0, BLOCK_SIZE_N)  # dstate
+    offs_k = tl.arange(0, BLOCK_SIZE_K)
+    st_mask = (offs_m[:, None] < hdim) & (offs_n[None, :] < dstate)
+
+    x_base = x_ptr + pid_b * stride_x_batch + pid_h * stride_x_head
+    b_base = b_ptr + pid_b * stride_b_batch + (pid_h // nheads_ngroups_ratio) * stride_b_head
+    dt_base = dt_ptr + pid_b * stride_dt_batch + pid_h * stride_dt_head
+    dA_base = dA_cumsum_ptr + pid_b * stride_dA_cs_batch + pid_h * stride_dA_cs_head
+    out_ptrs = (out_ptr + pid_b * stride_out_batch + pid_h * stride_out_head + offs_m[:, None] * stride_out_hdim +
+                offs_n[None, :] * stride_out_dstate)
+    fs_ptrs = (final_states_ptr + pid_b * stride_fs_batch + pid_h * stride_fs_head + offs_m[:, None] * stride_fs_hdim +
+               offs_n[None, :] * stride_fs_dstate)
+    if HAS_SEQ_IDX:
+        seq_base = seq_idx_ptr + pid_b * stride_seq_idx_batch
+
+    # ---- state_passing prologue (rc1 _state_passing_fwd_kernel) ----
+    if HAS_INITSTATES:
+        is_base = initstates_ptr + pid_h * stride_is_head
+        if not IS_CONT_BATCHED:
+            is_base += pid_b * stride_is_batch
+        is_offs = offs_m[:, None] * stride_is_hdim + offs_n[None, :] * stride_is_dstate
+        states = tl.load(is_base + is_offs, mask=st_mask, other=0.0).to(tl.float32)
+    else:
+        states = tl.zeros((BLOCK_SIZE_M, BLOCK_SIZE_N), dtype=tl.float32)
+    tl.store(out_ptrs, states, mask=st_mask)
+    out_ptrs += stride_out_chunk
+    prev_seq_idx_chunk_end = 0
+    logical_chunk_idx = 0
+
+    for c in range(nchunks):
+        # ---- chunk-local state (rc1 _chunk_state_fwd_kernel for pid_c = c) ----
+        x_ptrs = x_base + c * chunk_size * stride_x_seqlen + (offs_m[:, None] * stride_x_hdim +
+                                                              offs_k[None, :] * stride_x_seqlen)
+        b_ptrs = b_base + c * chunk_size * stride_b_seqlen + (offs_n[None, :] * stride_b_dstate +
+                                                              offs_k[:, None] * stride_b_seqlen)
+        dt_ptrs = dt_base + c * stride_dt_chunk + offs_k * stride_dt_csize
+        dA_chunk = dA_base + c * stride_dA_cs_chunk
+        dA_cs_last = tl.load(dA_chunk + (chunk_size - 1) * stride_dA_cs_csize).to(tl.float32)
+        dA_cumsum_ptrs = dA_chunk + offs_k * stride_dA_cs_csize
+        chunk_size_limit = min(chunk_size, seqlen - c * chunk_size)
+        if HAS_SEQ_IDX:
+            seq_idx_ptrs = seq_base + (c * chunk_size + offs_k) * stride_seq_idx_seqlen
+            seq_idx_last = tl.load(seq_base + (c * chunk_size + chunk_size_limit - 1) * stride_seq_idx_seqlen)
+        acc = tl.zeros((BLOCK_SIZE_M, BLOCK_SIZE_N), dtype=tl.float32)
+        for k in range(0, chunk_size_limit, BLOCK_SIZE_K):
+            x = tl.load(x_ptrs, mask=(offs_m[:, None] < hdim) & (offs_k[None, :] < chunk_size_limit - k), other=0.0)
+            b = tl.load(b_ptrs, mask=(offs_k[:, None] < chunk_size_limit - k) & (offs_n[None, :] < dstate),
+                        other=0.0).to(tl.float32)
+            dA_cs_k = tl.load(dA_cumsum_ptrs, mask=offs_k < chunk_size_limit - k, other=0.0).to(tl.float32)
+            if HAS_SEQ_IDX:
+                seq_idx_k = tl.load(seq_idx_ptrs, mask=offs_k < chunk_size_limit - k, other=-1)
+            dt_k = tl.load(dt_ptrs, mask=offs_k < chunk_size_limit - k, other=0.0).to(tl.float32)
+            if not HAS_SEQ_IDX:
+                scale = tl.exp(tl.minimum((dA_cs_last - dA_cs_k), 0.0)) * dt_k
+            else:
+                scale = tl.where(seq_idx_k == seq_idx_last, tl.exp(tl.minimum((dA_cs_last - dA_cs_k), 0.0)) * dt_k,
+                                 0.0)
+            b *= scale[:, None]
+            b = b.to(x_ptr.dtype.element_ty)
+            acc += tl.dot(x, b)
+            x_ptrs += BLOCK_SIZE_K * stride_x_seqlen
+            b_ptrs += BLOCK_SIZE_K * stride_b_seqlen
+            dt_ptrs += BLOCK_SIZE_K * stride_dt_csize
+            dA_cumsum_ptrs += BLOCK_SIZE_K * stride_dA_cs_csize
+            if HAS_SEQ_IDX:
+                seq_idx_ptrs += BLOCK_SIZE_K * stride_seq_idx_seqlen
+        new_states = acc  # rc1 stores this as FP32 and reloads it: identity
+
+        # ---- one step of the rc1 _state_passing_fwd_kernel loop ----
+        dA_cs = dA_cs_last
+        scale_mask = True
+        if HAS_SEQ_IDX:
+            seq_idx_chunk_end = tl.load(seq_base + (min((c + 1) * chunk_size, seqlen) - 1) * stride_seq_idx_seqlen)
+            if HAS_INITSTATES:
+                if IS_CONT_BATCHED and prev_seq_idx_chunk_end != seq_idx_chunk_end:
+                    states = tl.load(initstates_ptr + pid_h * stride_is_head + seq_idx_chunk_end * stride_is_batch +
+                                     offs_m[:, None] * stride_is_hdim + offs_n[None, :] * stride_is_dstate,
+                                     mask=st_mask, other=0.0).to(tl.float32)
+                    seq_idx_chunk_start = tl.load(seq_base + min(c * chunk_size, seqlen) * stride_seq_idx_seqlen)
+                    logical_chunk_idx += (seq_idx_chunk_end - seq_idx_chunk_start)
+                    c_off = tl.load(chunk_offsets_ptr + logical_chunk_idx, mask=logical_chunk_idx < chunk_meta_num,
+                                    other=0)
+                    if c_off > 0:
+                        dA_cs_boundary = tl.load(dA_chunk + (c_off - 1) * stride_dA_cs_csize,
+                                                 mask=(c_off - 1) > -1 and c_off < chunk_size, other=0.0)
+                        dA_cs -= dA_cs_boundary
+                logical_chunk_idx += 1
+            else:
+                scale_mask = seq_idx_chunk_end == prev_seq_idx_chunk_end
+            prev_seq_idx_chunk_end = seq_idx_chunk_end
+        scale = tl.where(scale_mask, tl.exp(dA_cs), 0.0)
+        states = scale * states + new_states
+        if c < nchunks - 1:
+            tl.store(out_ptrs, states, mask=st_mask)
+        else:
+            tl.store(fs_ptrs, states, mask=st_mask)
+        out_ptrs += stride_out_chunk
+
+
+def fused_chunk_state_passing(B, x, dt, dA_cumsum, initial_states=None, seq_idx=None, chunk_size=128,
+                              out_dtype=None, is_cont_batched=False, chunk_offsets=None):
