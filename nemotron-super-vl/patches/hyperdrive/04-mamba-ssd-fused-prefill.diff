+# Nemotron Hyperdrive (2026-10-22): single-pass Mamba-2 SSD prefill (chunk_state + state_passing + bmm + chunk_scan)
+# for one sequence (the chunked-prefill case: one long prompt per forward), TRT-LLM 1.4.0rc1.
+#
+# One program per (head, hdim block) walks the chunks in order and keeps the running SSM state in registers:
+#   out_c   = (C_c @ S_{c-1}) * exp(dA_cs)  +  ((C_c B_c^T) o decay o dt o causal) @ x_c  +  D x_c
+#   S_c     = exp(dA_last) * S_{c-1} + x_c^T (B_c * exp(dA_last - dA_cs) * dt)
+# so the per-chunk states (FP32 + state_dtype copies) and the CB matrices are never written to DRAM. Every operation is
+# written exactly as in the rc1 kernels it replaces (same masks, exp vs exp2 forms, casts: S -> state_dtype -> bf16 before
+# the C @ S product, FP32 accumulation chains), aiming at bit-identical outputs; tests check that on real layer data.
+# Only the state entering the LAST chunk is stored (chunk_state_varlen reads exactly that one) plus the final state.
+import torch
+import triton
+import triton.language as tl
+
+# test hook: a dict of meta-parameters (+ num_warps/num_stages) to bypass the autotuner; None in production
+_FORCE_CONFIG = None
+
+LOG2_E = tl.constexpr(1.4426950408889634)
+
+
+@triton.autotune(
+    configs=[
+        # the 6 fastest of 14 screened on GB10 (8192-token chunk: 2.57-3.17 ms vs rc1 6.68 ms); all 14 bit-identical
+        triton.Config({"BLOCK_SIZE_N": 64, "BLOCK_SIZE_M": 64, "BLOCK_SIZE_K": 64, "BLOCK_SIZE_KS": 32}, num_stages=1,
+                      num_warps=8),
+        triton.Config({"BLOCK_SIZE_N": 32, "BLOCK_SIZE_M": 64, "BLOCK_SIZE_K": 64, "BLOCK_SIZE_KS": 32}, num_stages=1,
+                      num_warps=4),
+        triton.Config({"BLOCK_SIZE_N": 64, "BLOCK_SIZE_M": 128, "BLOCK_SIZE_K": 32, "BLOCK_SIZE_KS": 32}, num_stages=1,
+                      num_warps=8),
+        triton.Config({"BLOCK_SIZE_N": 32, "BLOCK_SIZE_M": 64, "BLOCK_SIZE_K": 64, "BLOCK_SIZE_KS": 32}, num_stages=2,
+                      num_warps=4),
+        triton.Config({"BLOCK_SIZE_N": 32, "BLOCK_SIZE_M": 64, "BLOCK_SIZE_K": 64, "BLOCK_SIZE_KS": 64}, num_stages=1,
+                      num_warps=4),
+        triton.Config({"BLOCK_SIZE_N": 64, "BLOCK_SIZE_M": 64, "BLOCK_SIZE_K": 64, "BLOCK_SIZE_KS": 32}, num_stages=1,
+                      num_warps=4),
+    ],
+    key=["hdim", "dstate", "chunk_size", "HAS_INITSTATES", "HAS_D"],
+)
+@triton.jit
+def _fused_ssd_single_seq_kernel(
+    x_ptr, b_ptr, c_ptr, dt_ptr, dA_cumsum_ptr, D_ptr, initstates_ptr, out_ptr, states_ptr, final_states_ptr,
+    hdim, dstate, chunk_size, nchunks, seqlen, nheads_ngroups_ratio,
+    stride_x_seqlen, stride_x_head, stride_x_hdim,
+    stride_b_seqlen, stride_b_head, stride_b_dstate,
+    stride_c_seqlen, stride_c_head, stride_c_dstate,
+    stride_dt_chunk, stride_dt_head, stride_dt_csize,
+    stride_dA_cs_chunk, stride_dA_cs_head, stride_dA_cs_csize,
+    stride_D_head,
+    stride_is_head, stride_is_hdim, stride_is_dstate,
+    stride_out_seqlen, stride_out_head, stride_out_hdim,
+    stride_st_chunk, stride_st_head, stride_st_hdim, stride_st_dstate,
+    stride_fs_head, stride_fs_hdim, stride_fs_dstate,
+    HAS_INITSTATES: tl.constexpr, HAS_D: tl.constexpr, HAS_SEQ_IDX: tl.constexpr,
+    BLOCK_SIZE_DSTATE: tl.constexpr, BLOCK_SIZE_CHUNK: tl.constexpr,
+    BLOCK_SIZE_N: tl.constexpr, BLOCK_SIZE_M: tl.constexpr, BLOCK_SIZE_K: tl.constexpr, BLOCK_SIZE_KS: tl.constexpr,
+):
+    pid_n = tl.program_id(axis=0)
+    pid_h = tl.program_id(axis=1)
+    pid_g = pid_h // nheads_ngroups_ratio
+    offs_n = pid_n * BLOCK_SIZE_N + tl.arange(0, BLOCK_SIZE_N)  # hdim
+    offs_s = tl.arange(0, BLOCK_SIZE_DSTATE)  # dstate
+    st_mask = (offs_n[:, None] < hdim) & (offs_s[None, :] < dstate)
+    x_base = x_ptr + pid_h * stride_x_head
+    b_base = b_ptr + pid_g * stride_b_head
+    c_base = c_ptr + pid_g * stride_c_head
+    dt_base = dt_ptr + pid_h * stride_dt_head
+    dA_base = dA_cumsum_ptr + pid_h * stride_dA_cs_head
+    out_base = out_ptr + pid_h * stride_out_head
+    if HAS_D:
+        Dv = tl.load(D_ptr + pid_h * stride_D_head).to(tl.float32)
+
+    # S: [hdim block, dstate], FP32 running state (rc1 state_passing keeps it in FP32 registers too)
+    if HAS_INITSTATES:
+        S = tl.load(initstates_ptr + pid_h * stride_is_head + offs_n[:, None] * stride_is_hdim +
+                    offs_s[None, :] * stride_is_dstate, mask=st_mask, other=0.0).to(tl.float32)
+    else:
+        S = tl.zeros((BLOCK_SIZE_N, BLOCK_SIZE_DSTATE), dtype=tl.float32)
+
+    for c in range(nchunks):
+        c64 = c.to(tl.int64)
+        chunk_size_limit = min(chunk_size, seqlen - c * chunk_size)
+        dA_chunk = dA_base + c64 * stride_dA_cs_chunk
+        dt_chunk = dt_base + c64 * stride_dt_chunk
+        x_chunk = x_base + c64 * chunk_size * stride_x_seqlen
+        b_chunk = b_base + c64 * chunk_size * stride_b_seqlen
+        c_chunk = c_base + c64 * chunk_size * stride_c_seqlen
+        # rc1 chunk_scan reads the passed state from the state_dtype tensor and casts it to C's dtype
+        prev = S.to(states_ptr.dtype.element_ty).to(c_ptr.dtype.element_ty)
+        if c == nchunks - 1:
+            tl.store(states_ptr + c64 * stride_st_chunk + pid_h * stride_st_head + offs_n[:, None] * stride_st_hdim +
+                     offs_s[None, :] * stride_st_dstate, S, mask=st_mask)
+        prev_t = tl.trans(prev)  # [dstate, hdim block]
+
+        # ---------------- rc1 _chunk_scan_fwd_kernel body, all row blocks of this chunk ----------------
+        for mb in range(0, BLOCK_SIZE_CHUNK, BLOCK_SIZE_M):
+            offs_m = mb + tl.arange(0, BLOCK_SIZE_M)
+            dA_cs_m = tl.load(dA_chunk + offs_m * stride_dA_cs_csize, mask=offs_m < chunk_size, other=0.0).to(tl.float32)
+            scale_m = tl.math.exp2(dA_cs_m * LOG2_E)
+            Cm = tl.load(c_chunk + offs_m[:, None] * stride_c_seqlen + offs_s[None, :] * stride_c_dstate,
+                         mask=(offs_m[:, None] < chunk_size_limit) & (offs_s[None, :] < dstate), other=0.0)
+            acc = tl.dot(Cm, prev_t) * scale_m[:, None]
+            offs_k = tl.arange(0, BLOCK_SIZE_K)
+            K_MAX = min(mb + BLOCK_SIZE_M, chunk_size_limit)
+            for k in range(0, K_MAX, BLOCK_SIZE_K):
+                # CB tile = rc1 _bmm_chunk_fwd_kernel(C, B) (FP32 out; rows/cols past the chunk end are 0)
+                Bk = tl.load(b_chunk + (k + offs_k)[:, None] * stride_b_seqlen + offs_s[None, :] * stride_b_dstate,
+                             mask=((k + offs_k)[:, None] < chunk_size_limit) & (offs_s[None, :] < dstate), other=0.0)
+                cb = tl.dot(Cm, tl.trans(Bk))
+                if HAS_SEQ_IDX:  # single sequence: rc1 zeroes CB rows/cols past the chunk end (seq_idx -1/-2)
+                    cb = tl.where((offs_m[:, None] < chunk_size_limit) & ((k + offs_k)[None, :] < chunk_size_limit),
+                                  cb, 0.0)
+                dA_cs_k = tl.load(dA_chunk + (k + offs_k) * stride_dA_cs_csize, mask=offs_k < chunk_size - k,
+                                  other=0.0).to(tl.float32)
+                cb *= tl.math.exp2((dA_cs_m[:, None] - dA_cs_k[None, :]) * LOG2_E)
+                dt_k = tl.load(dt_chunk + (k + offs_k) * stride_dt_csize, mask=offs_k < chunk_size - k,
+                               other=0.0).to(tl.float32)
+                cb *= dt_k
+                mask = offs_m[:, None] >= k + offs_k[None, :]
+                cb = tl.where(mask, cb, 0.0)
+                cb = cb.to(x_ptr.dtype.element_ty)
+                xk = tl.load(x_chunk + (k + offs_k)[:, None] * stride_x_seqlen + offs_n[None, :] * stride_x_hdim,
+                             mask=(offs_k[:, None] < chunk_size_limit - k) & (offs_n[None, :] < hdim), other=0.0)
+                acc += tl.dot(cb, xk)
+            if HAS_D:
+                x_res = tl.load(x_chunk + offs_m[:, None] * stride_x_seqlen + offs_n[None, :] * stride_x_hdim,
+                                mask=(offs_m[:, None] < chunk_size_limit) & (offs_n[None, :] < hdim),
+                                other=0.0).to(tl.float32)
+                acc += x_res * Dv
+            tl.store(out_base + (c64 * chunk_size + offs_m)[:, None] * stride_out_seqlen +
+                     offs_n[None, :] * stride_out_hdim, acc,
+                     mask=(offs_m[:, None] < chunk_size_limit) & (offs_n[None, :] < hdim))
+
+        # ---------------- rc1 _chunk_state_fwd_kernel (this chunk) + one _state_passing_fwd step ----------------
+        dA_cs_last = tl.load(dA_chunk + (chunk_size - 1) * stride_dA_cs_csize).to(tl.float32)
+        offs_ks = tl.arange(0, BLOCK_SIZE_KS)
+        acc_s = tl.zeros((BLOCK_SIZE_N, BLOCK_SIZE_DSTATE), dtype=tl.float32)
+        for k in range(0, chunk_size_limit, BLOCK_SIZE_KS):
+            xs = tl.load(x_chunk + (k + offs_ks)[None, :] * stride_x_seqlen + offs_n[:, None] * stride_x_hdim,
+                         mask=(offs_n[:, None] < hdim) & (offs_ks[None, :] < chunk_size_limit - k), other=0.0)
+            bs = tl.load(b_chunk + (k + offs_ks)[:, None] * stride_b_seqlen + offs_s[None, :] * stride_b_dstate,
+                         mask=(offs_ks[:, None] < chunk_size_limit - k) & (offs_s[None, :] < dstate),
+                         other=0.0).to(tl.float32)
+            dA_cs_k = tl.load(dA_chunk + (k + offs_ks) * stride_dA_cs_csize, mask=offs_ks < chunk_size_limit - k,
+                              other=0.0).to(tl.float32)
+            dt_k = tl.load(dt_chunk + (k + offs_ks) * stride_dt_csize, mask=offs_ks < chunk_size_limit - k,
+                           other=0.0).to(tl.float32)
+            if HAS_SEQ_IDX:
+                scale = tl.where(offs_ks < chunk_size_limit - k,
+                                 tl.exp(tl.minimum((dA_cs_last - dA_cs_k), 0.0)) * dt_k, 0.0)
+            else:
+                scale = tl.exp(tl.minimum((dA_cs_last - dA_cs_k), 0.0)) * dt_k
+            bs *= scale[:, None]
+            bs = bs.to(x_ptr.dtype.element_ty)
+            acc_s += tl.dot(xs, bs)
+        scale_c = tl.exp(dA_cs_last)
+        S = scale_c * S + acc_s
+    tl.store(final_states_ptr + pid_h * stride_fs_head + offs_n[:, None] * stride_fs_hdim +
+             offs_s[None, :] * stride_fs_dstate, S, mask=st_mask)
+
+
+def fused_ssd_single_seq(x, dt, dA_cumsum, B, C, D=None, initial_states=None, chunk_size=128, state_dtype=None,
+                         out=None, has_seq_idx=True):
+    """x (1, L, H, P), dt/dA_cumsum (1, H, nchunks, cs) from _chunk_cumsum_fwd, B/C (1, L, G, N), D (H,),
+    initial_states (1, H, P, N) or None, out (1, L, H, P). Returns (states, final_states): states (1, nchunks, H, P, N)
+    in state_dtype with ONLY the last chunk written (what chunk_state_varlen reads); final_states FP32."""
+    batch, seqlen, nheads, headdim = x.shape
+    assert batch == 1
+    _, _, nchunks, cs = dt.shape
+    assert cs == chunk_size
+    _, _, ngroups, dstate = B.shape
+    assert D is None or D.dim() == 1
+    st_dtype = state_dtype if state_dtype is not None else C.dtype
+    states = torch.empty((1, nchunks, nheads, headdim, dstate), device=x.device, dtype=st_dtype)
+    final_states = torch.empty((1, nheads, headdim, dstate), device=x.device, dtype=torch.float32)
+    ist = initial_states
+    grid = lambda META: (triton.cdiv(headdim, META["BLOCK_SIZE_N"]), nheads)
+    with torch.cuda.device(x.device.index):
+        kern = _fused_ssd_single_seq_kernel if _FORCE_CONFIG is None else _fused_ssd_single_seq_kernel.fn
+        kern[grid](
+            x, B, C, dt, dA_cumsum, D, ist, out, states, final_states,
+            headdim, dstate, chunk_size, nchunks, seqlen, nheads // ngroups,
+            x.stride(1), x.stride(2), x.stride(3),
+            B.stride(1), B.stride(2), B.stride(3),
+            C.stride(1), C.stride(2), C.stride(3),
