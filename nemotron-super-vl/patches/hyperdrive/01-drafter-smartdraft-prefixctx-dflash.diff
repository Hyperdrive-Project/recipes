+# NHD dflash-ctx-carry ---------------------------------------------------------------------------------------------
+# On SM121 the LiLiCorr drafter runs VANILLA attention over a dense private context arena (one slot per request,
+# reuse_addressable=False). When block reuse lets the target skip a cached prompt prefix, stock DFlash starts the new
+# request's slot empty and the drafter sees only the uncached tail, so acceptance drops on follow-up turns. The arena
+# slot of the request that produced that prefix still holds the drafter K/V for it (eviction only zeroes _ctx_len).
+# With NHD_DFLASH_CTX_CARRY=1 the worker keeps a finished request's slot contents ("retired" slot, LRU) and hands the
+# slot to a later request whose prompt tokens [0, first_pos) equal the retired request's, resuming at first_pos.
+# No new GPU memory, no extra target compute. Drafts only steer verification, so outputs are unchanged.
+class DFlashCtxCarryManager(BaseResourceManager):
+    """Spec resource manager that records prompt tokens per request for DFlashWorker's ctx carry-over.
+
+    Holds no GPU memory. Wraps an optional SuffixAutomatonManager (``sa_manager``; the SA lookups in this file and in
+    the decoder runner already accept a wrapper through that attribute) and forwards every hook to it.
+    """
+
+    def __init__(self, max_num_requests: int, sa_manager=None):
+        self.max_num_requests = max_num_requests
+        self.sa_manager = sa_manager
+        # request id -> (prompt tokens as int32 ndarray, multimodal signature or None)
+        self.prompt_tokens = {}
+
+    @staticmethod
+    def _rid(req):
+        rid = getattr(req, "py_request_id", None)
+        return req.request_id if rid is None else rid
+
+    @staticmethod
+    def _mm_signature(req):
+        try:
+            h = getattr(req, "multimodal_hashes", None)
+            pos = getattr(req, "multimodal_positions", None)
+            if not h and getattr(req, "py_multimodal_data", None) is None:
+                return None
+            return repr((h, pos, sorted((getattr(req, "py_multimodal_data", None) or {}).keys())))
+        except Exception:  # unknown binding shape: refuse to carry rather than guess
+            return "<unknown>"
+
+    def prepare_resources(self, scheduled_batch):
+        if self.sa_manager is not None:
+            self.sa_manager.prepare_resources(scheduled_batch)
+        for req in scheduled_batch.context_requests:
+            if getattr(req, "is_dummy", False) or getattr(req, "is_generation_only_request", False):
+                continue
+            rid = self._rid(req)
+            if rid in self.prompt_tokens:
+                continue
+            self.prompt_tokens[rid] = (np.asarray(req.get_tokens(0), dtype=np.int32), self._mm_signature(req))
+
+    def update_resources(self, scheduled_batch):
+        if self.sa_manager is not None:
+            self.sa_manager.update_resources(scheduled_batch)
+
+    def free_resources(self, request):
+        if self.sa_manager is not None:
+            self.sa_manager.free_resources(request)
+        self.prompt_tokens.pop(self._rid(request), None)
+
+    def add_dummy_requests(self, request_ids):
+        if self.sa_manager is not None:
+            self.sa_manager.add_dummy_requests(request_ids)
+
+    def shutdown(self):
+        if self.sa_manager is not None:
+            self.sa_manager.shutdown()
+        self.prompt_tokens.clear()
+
+    def get_max_resource_count(self) -> int:
+        return self.max_num_requests
+
+    def get_needed_resource_to_completion(self, request) -> int:
+        return 0
+
+
+def _nhd_carry_manager(spec_metadata):
+    rm = getattr(spec_metadata, "spec_resource_manager", None)
+    return rm if isinstance(rm, DFlashCtxCarryManager) else None
