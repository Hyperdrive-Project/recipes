+    def _nhd_host_tick(self) -> None:
+        """Host side, once per step from DFlashSpecMetadata.prepare(): theta control file and trace flush."""
+        if self._nhd_vlen is None or torch.cuda.is_current_stream_capturing():
+            return
+        self._nhd_prep_n += 1
+        if _NHD_ADAPTK_CTL and self._nhd_prep_n % 16 == 0:
+            try:
+                mt = os.stat(_NHD_ADAPTK_CTL).st_mtime
+            except OSError:
+                mt = None
+            if mt is not None and mt != self._nhd_ctl_mtime:
+                self._nhd_ctl_mtime = mt
+                try:
+                    theta = float(open(_NHD_ADAPTK_CTL).read().strip() or 0)
+                except (OSError, ValueError):
+                    theta = None
+                if theta is not None and theta != self._nhd_theta_host:
+                    self._nhd_theta.fill_(theta)
