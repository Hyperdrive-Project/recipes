+    def _nhd_init_adaptk(self, num_slots: int, max_batch: int) -> None:
+        self._nhd_vlen = None
+        self._nhd_ring = None
+        self._nhd_vl_used = None
+        if not (_NHD_ADAPTK or _NHD_ADAPTK_TRACE):
+            return
+        K = self.max_draft_len
+        self._nhd_K = K
+        self._nhd_vlen = torch.full((num_slots,), K, dtype=torch.int32, device="cuda")
+        theta = float(os.environ.get("NHD_ADAPTK_THETA", "0") or 0)
+        self._nhd_theta = torch.full((1,), theta, dtype=torch.float32, device="cuda")
+        self._nhd_theta_host = theta
+        self._nhd_ctl_mtime = None
+        self._nhd_prep_n = 0
+        self._nhd_epoch = torch.zeros(num_slots, dtype=torch.float32, device="cuda")
+        self._nhd_epoch_host = [0] * num_slots
+        if _NHD_ADAPTK_TRACE:
+            self._nhd_bsmax = max_batch
+            self._nhd_ring = torch.full(
+                (_NHD_RING, max_batch, 4 + K), -1.0, dtype=torch.float32, device="cuda"
+            )
+            self._nhd_ctr = torch.zeros(1, dtype=torch.long, device="cuda")
+            self._nhd_flushed = 0
+            self._nhd_last_flush = time.time()
+        logger.info(
+            f"[nhd-adaptk] enabled: policy={'on' if _NHD_ADAPTK else 'off'} trace={_NHD_ADAPTK_TRACE} "
+            f"theta={theta} ctl={_NHD_ADAPTK_CTL or '-'} K={K} slots={num_slots}"
+        )
+
+    def sample_and_accept_draft_tokens(self, logits, attn_metadata, spec_metadata):
+        """NHD adaptk: force-reject drafts past each request's verify length (strict acceptance only)."""
+        if self._nhd_vlen is None:
+            return super().sample_and_accept_draft_tokens(logits, attn_metadata, spec_metadata)
+        batch_size = attn_metadata.num_seqs
+        num_contexts = attn_metadata.num_contexts
+        num_gens = batch_size - num_contexts
+        draft_tokens = self._reshape_draft_tokens_for_accept(spec_metadata, num_gens, logits.device)
+        self._nhd_vl_used = None
+        if num_gens > 0 and draft_tokens.dim() == 2 and draft_tokens.shape[1] > 0:
+            vl = self._nhd_vlen[self._batch_to_slot[num_contexts : num_contexts + num_gens]]
+            self._nhd_vl_used = vl
+            if (
+                _NHD_ADAPTK
+                and not getattr(spec_metadata, "enable_penalty", False)
+                and not self._can_use_rejection_sampling(spec_metadata)
+            ):
+                pos = torch.arange(1, draft_tokens.shape[1] + 1, device=draft_tokens.device)
+                draft_tokens = torch.where(
+                    pos[None, :] > vl[:, None].to(pos.dtype),
+                    torch.full_like(draft_tokens, -1),
+                    draft_tokens,
+                )
