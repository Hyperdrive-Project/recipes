+# NHD dflash-prefix-ctx -------------------------------------------------------------------------------------------
+class DFlashPrefixCtxTracker(BaseResourceManager):
+    """Spec resource manager recording each request's tokens for DFlashWorker's prefix-keyed drafter context.
+
+    Holds no GPU memory. ``info[rid] = [prompt_tokens (int32 ndarray), mm_signature, final_tokens or None]``.
+    Final tokens (prompt + generated) are recorded when the request is freed; finished entries are kept LRU-capped.
+    Wraps an optional SuffixAutomatonManager (``sa_manager``) and forwards every hook to it.
+    """
+
+    _FINISHED_CAP = 64
+
+    def __init__(self, max_num_requests: int, sa_manager=None):
+        self.max_num_requests = max_num_requests
+        self.sa_manager = sa_manager
+        self.info = {}
+        self.finished = OrderedDict()
+
+    @staticmethod
+    def _rid(req):
+        rid = getattr(req, "py_request_id", None)
+        return req.request_id if rid is None else rid
+
+    @staticmethod
+    def _mm_signature(req):
+        try:
+            h = getattr(req, "multimodal_hashes", None)
+            pos = getattr(req, "multimodal_positions", None)
+            if not h and getattr(req, "py_multimodal_data", None) is None:
+                return None
+            return repr((h, pos, sorted((getattr(req, "py_multimodal_data", None) or {}).keys())))
+        except Exception:  # unknown binding shape: never match anything
+            return object()
+
+    def prepare_resources(self, scheduled_batch):
+        if self.sa_manager is not None:
+            self.sa_manager.prepare_resources(scheduled_batch)
+        for req in scheduled_batch.context_requests:
+            if getattr(req, "is_dummy", False) or getattr(req, "is_generation_only_request", False):
+                continue
+            rid = self._rid(req)
+            if rid in self.info:
+                continue
+            try:
+                toks = np.asarray(req.get_tokens(0), dtype=np.int32)
+            except Exception:
+                continue
+            self.info[rid] = [toks, self._mm_signature(req), None]
+
+    def update_resources(self, scheduled_batch):
+        if self.sa_manager is not None:
+            self.sa_manager.update_resources(scheduled_batch)
+
+    def free_resources(self, request):
+        if self.sa_manager is not None:
+            self.sa_manager.free_resources(request)
+        rid = self._rid(request)
+        ent = self.info.get(rid)
+        if ent is None:
+            return
+        try:
+            ent[2] = np.asarray(request.get_tokens(0), dtype=np.int32)
+        except Exception:
+            ent[2] = None
+        self.finished[rid] = True
+        self.finished.move_to_end(rid)
+        while len(self.finished) > self._FINISHED_CAP:
+            old, _ = self.finished.popitem(last=False)
+            self.info.pop(old, None)
+
+    def add_dummy_requests(self, request_ids):
+        if self.sa_manager is not None:
+            self.sa_manager.add_dummy_requests(request_ids)
+
+    def shutdown(self):
+        if self.sa_manager is not None:
+            self.sa_manager.shutdown()
+        self.info.clear()
+        self.finished.clear()
+
+    def get_max_resource_count(self) -> int:
+        return self.max_num_requests
+
+    def get_needed_resource_to_completion(self, request) -> int:
+        return 0
+
+
+def _nhd_pc_tracker(spec_metadata):
+    rm = getattr(spec_metadata, "spec_resource_manager", None)
+    return rm if isinstance(rm, DFlashPrefixCtxTracker) else None
