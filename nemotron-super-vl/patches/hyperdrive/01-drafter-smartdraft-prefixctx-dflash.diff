+
+    def _nhd_flush(self) -> None:
+        self._nhd_last_flush = time.time()
+        n = int(self._nhd_ctr.item())
+        if n <= self._nhd_flushed:
+            return
+        lo = max(self._nhd_flushed, n - _NHD_RING)
+        idx = torch.arange(lo, n, device=self._nhd_ring.device) % _NHD_RING
+        rows = self._nhd_ring.index_select(0, idx).cpu().tolist()
+        try:
+            with open(_NHD_ADAPTK_OUT, "a") as f:
+                for i, step in zip(range(lo, n), rows):
+                    for b in step:
+                        if b[0] < 0 or int(b[0]) == self._dummy_slot:
+                            continue
+                        f.write(
+                            json.dumps(
+                                {
+                                    "i": i,
+                                    "slot": int(b[0]),
+                                    "ep": int(b[1]),
+                                    "nacc": int(b[2]),
+                                    "vl": int(b[3]),
+                                    "theta": self._nhd_theta_host,
+                                    "conf": [round(x, 4) for x in b[4:]],
+                                }
+                            )
+                            + "\n"
+                        )
+        except OSError as ex:
+            logger.warning(f"[nhd-adaptk] trace flush failed: {ex}")
+        self._nhd_flushed = n
